generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model BusinessCentralConfig {
  id           Int      @id @default(1)
  tenantId     String   @default("325946cd-5a64-466a-89b4-c7db382b75b6")
  clientId     String   @default("")
  clientSecret String   @default("")
  environment  String   @default("Production")
  companyId    String   @default("")
  updatedAt    DateTime @updatedAt
}

model ApiConfig {
  key       String   @id
  url       String   @default("")
  config    String?
  updatedAt DateTime @updatedAt
}

model ActionLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  user      String   @default("Sistema")
  action    String
  details   String?
  companyId String?
}

model CashflowConfig {
  id             Int      @id @default(autoincrement())
  companyId      String   @default("")
  currencyCode   String   @default("EUR")
  initialBalance Float    @default(0)
  updatedAt      DateTime @default(now()) @updatedAt
  
  @@unique([companyId, currencyCode])
}

model CashflowManualEntry {
  id           Int      @id @default(autoincrement())
  companyId    String   @default("")
  currencyCode String   @default("EUR")
  date         DateTime
  description  String
  amount       Float
  balance      Float?
  isArchived   Boolean  @default(false)
  bankAccount  String?
  sourceFile   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BankStatementImport {
  id             Int      @id @default(autoincrement())
  companyId      String   @default("")
  filename       String
  bankAccount    String?
  currencyCode   String   @default("EUR")
  importDate     DateTime @default(now())
  totalRows      Int      @default(0)
  totalIncome    Float    @default(0)
  totalExpense   Float    @default(0)
  initialBalance Float?
  finalBalance   Float?
}