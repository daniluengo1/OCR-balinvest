generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model BusinessCentralConfig {
  id           Int      @id @default(1)
  tenantId     String   @default("325946cd-5a64-466a-89b4-c7db382b75b6")
  clientId     String   @default("")
  clientSecret String   @default("")
  environment  String   @default("Production")
  companyId    String   @default("")
  updatedAt    DateTime @updatedAt
}

model ApiConfig {
  key       String   @id
  url       String   @default("")
  config    String?
  updatedAt DateTime @updatedAt
}

model ActionLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  user      String   @default("Sistema")
  action    String
  details   String?
  companyId String?
}